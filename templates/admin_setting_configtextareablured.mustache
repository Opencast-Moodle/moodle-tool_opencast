{{!
    @template tool_opencast/admin_setting_configtextareablured

    Admin textarea setting blur wrapper template.

    Context variables required for this template:
    * rows - number of rows
    * cols - number of cols
    * id - element id
    * name - element name
    * value - default text
    * forceltr - always ltr

    Example context (json):
    {
        "name": "test",
        "id": "test0",
        "wrapperid": "wrapper-test0",
        "value": "Your aims are high, and you are capable of much.",
        "rows": 5,
        "cols": 30
    }
}}
<div class="form-textarea-blured blur" id="blur-container-{{ wrapperid }}">
    {{>core_admin/setting_configtextarea}}
    <a href="#" class="blur-link-btn" id="blur-link-btn-{{ wrapperid }}" title="{{ unmaskhint }}" data-blured="true">
        {{# pix }} t/passwordunmask-reveal, core, {{# str }} passwordunmaskrevealhint, form {{/ str }} {{/ pix }}
    </a>
</div>
{{#js}}
require(['jquery'], function($) {
    $("#blur-link-btn-{{ wrapperid }}").click(function(e) {
        e.preventDefault();
        var isBlured = $(this).data('blured');
        $("#blur-container-{{ wrapperid }}").toggleClass("blur", !isBlured);
        $(this).data('blured', !isBlured);
    });
});
{{/js}}
