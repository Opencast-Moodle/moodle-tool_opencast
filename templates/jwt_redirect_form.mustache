{{!
  @template tool_opencast/jwt_redirect_form

  Opencast JWT redirect form template
  For external services of Opencast we use a redirect form to ensure authentication happens correctly!

  Example context (json):
  {
      "formid": "jwt_redirect_form"
      "redirecturl": ".../redirect/get",
      "jwt": "...",
      "targeturl": ".../studio...",
  }
}}
<form id="{{formid}}" action="{{redirecturl}}" role="form" method="post">
    <input type="hidden" name="jwt" value="{{jwt}}">
    <input type="hidden" name="target" value="{{targeturl}}">
</form>
